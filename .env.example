# Copy this file to .env and fill in your Supabase project values
# (Supabase dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional: free key from rawg.io/apidocs, enables "Search by name" on the Add game screen
EXPO_PUBLIC_RAWG_KEY=
